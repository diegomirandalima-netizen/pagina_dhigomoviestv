
/* Configurações Gerais */
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: Arial, Helvetica, sans-serif;
}

body {
    background-color: #000000;
    color: #ffffff;
}

/* Cabeçalho */
.cabecalho {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 20px 40px;
    background-color: #000000;
}

.area_logo {
    display: flex;
    align-items: center;
    gap: 15px;
}

.logo_imagem {
    width: 60px;
    height: 60px;
    border-radius: 50%;
    background-color: #222;
    object-fit: cover;
}

.titulo_site {
    font-size: 2.2rem;
    font-weight: bold;
    color: #ffffff;
    text-shadow: 2px 2px 4px #ff0000;
}

/* Barra de Busca */
.barra_busca {
    display: flex;
    align-items: center;
    border: 2px solid #b31217;
    border-radius: 25px;
    padding: 6px 16px;
    background-color: #0d0d0d;
    width: 220px;
}

.icone_busca {
    margin-right: 8px;
    font-size: 1rem;
}

.campo_busca {
    background: transparent;
    border: none;
    color: #ffffff;
    font-size: 1rem;
    font-weight: bold;
    outline: none;
    width: 100%;
}

.campo_busca::placeholder {
    color: #ffffff;
}

/* Barra de Streamings */
.barra_streamings {
    display: flex;
    width: 100%;
    height: 55px;
    margin-bottom: 30px;
    overflow-x: auto;
}

.card_streaming {
    flex: 1;
    display: flex;
    justify-content: center;
    align-items: center;
    font-weight: bold;
    font-size: 1.3rem;
    cursor: pointer;
    min-width: 160px;
}

.prime {
    background-color: #00a8e1;
    color: #ffffff;
}

.netflix {
    background-color: #141414;
    color: #e50914;
    letter-spacing: 2px;
}

.disney {
    background-color: #040714;
    color: #ffffff;
}

.globoplay {
    background-color: #1a1a1a;
    color: #ff4500;
}

.paramount {
    background-color: #0064ff;
    color: #ffffff;
}

/* Conteúdo Principal (Lista de Filmes) */
.lista_filmes {
    max-width: 1100px;
    margin: 0 auto;
    padding: 10px 25px 30px 25px;
}

.item_filme {
    display: flex;
    gap: 30px;
    margin-bottom: 45px;
    align-items: flex-start;
}

/* Coluna da Capa + Botão Trailer */
.coluna_esquerda {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 150px;
    flex-shrink: 0;
}

.imagem1,
.imagem2,
.imagem3,
.imagem4 {
    width: 150px;
    height: 220px;
    object-fit: cover;
    border-radius: 4px;
    background-color: #1c1c1c;
    margin-bottom: 12px;
}

.botao_trailer {
    display: inline-block;
    width: 110px;
    padding: 6px 0;
    text-align: center;
    color: #ffffff;
    text-decoration: none;
    font-weight: bold;
    font-size: 1rem;
    border: 2px solid #b31217;
    border-radius: 20px;
    background-color: #000000;
    transition: background-color 0.2s, transform 0.2s;
}

.botao_trailer:hover {
    background-color: #b31217;
    transform: scale(1.03);
}

/* Coluna de Textos (Informações e Sinopse) */
.texto1,
.texto2,
.texto3,
.texto4 {
    flex: 1;
}

.texto1 h2,
.texto2 h2,
.texto3 h2,
.texto4 h2 {
    font-size: 1.05rem;
    margin-bottom: 12px;
    color: #ffffff;
}

.texto1 p,
.texto2 p,
.texto3 p,
.texto4 p {
    font-size: 0.9rem;
    line-height: 1.5;
    margin-bottom: 10px;
    color: #e0e0e0;
}

/* Área e Estilo do Botão Página 2 */
.area_paginacao {
    display: flex;
    justify-content: center;
    margin: 40px 0 20px 0;
}

.botao_pagina2 {
    display: inline-block;
    width: 130px;
    padding: 8px 0;
    text-align: center;
    color: #ffffff;
    text-decoration: none;
    font-weight: bold;
    font-size: 1rem;
    border: 2px solid #b31217;
    border-radius: 20px;
    background-color: #000000;
    transition: background-color 0.2s, transform 0.2s;
}

.botao_pagina2:hover {
    background-color: #b31217;
    transform: scale(1.03);
}

/* Rodapé (Footer) */
.rodape {
    width: 100%;
    background-color: #000000;
    padding: 20px 0 35px 0;
    margin-top: 20px;
}

.linha_rodape {
    border: none;
    height: 3px;
    background-color: #8c2d23;
    width: 100%;
    margin-bottom: 12px;
}

.conteudo_rodape {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 10px;
}

.logo_rodape {
    width: 55px;
    height: 55px;
    border-radius: 50%;
    object-fit: cover;
}

.texto_copyright {
    color: #ffffff;
    font-size: 0.95rem;
    font-weight: bold;
    text-align: center;
}

/* Responsividade para celulares */
@media (max-width: 650px) {
    .cabecalho {
        flex-direction: column;
        gap: 15px;
    }

    .item_filme {
        flex-direction: column;
        align-items: center;
        text-align: center;
    }
}
 